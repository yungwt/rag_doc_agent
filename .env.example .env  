# ============================================================
#  使用前先复制：cp .env.example .env  并填入真实值
#  .env 已被 .gitignore 忽略，不会提交到仓库
# ============================================================

# ── 应用 ──
APP_ENV=development
LOG_LEVEL=INFO

# ── MySQL ──
# 这些变量供 docker-compose 创建数据库/用户，也供本地开发使用
MYSQL_ROOT_PASSWORD=root_password_change_me
MYSQL_DATABASE=rag_doc_agent
MYSQL_USER=rag_user
MYSQL_PASSWORD=user_password_change_me

# 本地开发连 localhost；docker 内 compose 会自动覆盖 MYSQL_HOST=mysql，无需改这里
MYSQL_HOST=localhost
MYSQL_PORT=3306

# ── Redis ──
# 本地用 localhost；docker 内自动覆盖为 redis 服务名
REDIS_URL=redis://localhost:6379/0

# ── JWT ──
# 必填，生成方式：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Cookie（JWT 存储方式）──
# COOKIE_SECURE：生产走 HTTPS 时设为 true；本地 http 用 false
# COOKIE_SAMESITE：lax 已能在跨站 POST 时阻止 Cookie 携带，防 CSRF
COOKIE_SECURE=True
COOKIE_SAMESITE=lax

# ── LLM（通义千问 / OpenAI 兼容接口）──
LLM_MODEL=qwen3.7-max
LLM_API_KEY=填模型api key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── Embedding ──
EMBEDDING_MODEL=qwen3.7-text-embedding
# EMBEDDING_API_KEY 不填则自动复用 LLM_API_KEY
# EMBEDDING_BASE_URL 不填则自动复用 LLM_BASE_URL

# ── 文档处理 ──
MAX_UPLOAD_SIZE_MB=20
CHUNK_SIZE=500
CHUNK_OVERLAP=50
SESSION_HISTORY_LIMIT=10
