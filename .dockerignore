# 版本控制
.git
.gitignore

# 虚拟环境
.venv
venv
env

# 环境变量（运行时通过 env_file 注入，不打进镜像）
.env
.env.*

# Python 缓存
__pycache__
*.py[cod]
*.egg-info
.mypy_cache
.pytest_cache

# 本地数据 / 无用目录（不打包进镜像）
uploads
chroma_data
src
*.log

# ── 前端依赖与构建产物（避免 90+MB 的 node_modules 污染镜像）──
frontend/node_modules
frontend/dist
.workbuddy/
# IDE / 系统
.vscode
.idea
.DS_Store
